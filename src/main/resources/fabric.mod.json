{
	"schemaVersion": 1,
	"id": "${modId}",
	"version": "${version}",
	"name": "${modName}",
	"description": "${modDescription}",
	"authors": [
		"${authors}"
	],
	"contact": {
		"homepage": "${homepage}",
		"issues": "${issues}",
		"sources": "${sources}"
	},
	"license": "${license}",
	"icon": "assets/${modId}/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"folk.sisby.euphonium.EuphoniumClient"
		]
	},
	"depends": {
		"fabricloader": ">=${fl}",
		"minecraft": "~${mc}",
		"java": ">=25",
		"fabric-api": ">=${fapi}"
	}
}
